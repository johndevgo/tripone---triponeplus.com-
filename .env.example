# Production: https://tools.neurerohan.com.np
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated hostnames that serve the TripOne+ app instead of a tenant.
APP_HOSTS=tools.neurerohan.com.np,tripone-triponeplus-com.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Optional; server-only and used only for explicit account deletion.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional domain automation. Without these, users receive manual DNS instructions.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional: an existing confirmed Supabase Auth user used by pnpm seed:demo.
TRIPONE_DEMO_EMAIL=
TRIPONE_DEMO_PASSWORD=

# Optional Playwright credentials for a confirmed user with no existing site.
TRIPONE_E2E_EMAIL=
TRIPONE_E2E_PASSWORD=
TRIPONE_E2E_SITE_ID=

# Development/CI only: direct connection used by rollback-only database tests.
TRIPONE_DATABASE_URL=
